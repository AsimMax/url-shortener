PORT=5000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urlshortener
DB_SSL=false

# Redis
REDIS_URL=redis://localhost:6379

# Public base URL used to build short links (change to your Render URL in production)
BASE_URL=http://localhost:5000

# Comma-separated list of allowed frontend origins, or * for all
CORS_ORIGIN=http://localhost:5173
